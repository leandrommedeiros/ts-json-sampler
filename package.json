{
  "name": "@leandrommedeiros/ts-json-sampler",
  "version": "1.0.2",
  "description": "Generates sample JSON for selected types",
  "author": "Leandro Medeiros <leandro.medeiros@live.com>",
  "license": "BSD 2",
  "bin": {
    "ts-json-sampler": "./build/ts-json-sampler-cli.js"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "docs"
  ],
  "scripts": {
    "test": "jest",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "package": "pkg build/ts-json-sampler-cli.js --output bin/ts-json-sampler",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "publish:public": "npm publish --access public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandrommedeiros/ts-json-sampler.git"
  },
  "keywords": [
    "JSON Schema",
    "faker",
    "generator",
    "json",
    "sample",
    "sampler",
    "typescript"
  ],
  "dependencies": {
    "ansi-colors": "^4.1.3",
    "cli-progress": "^3.12.0",
    "lodash": "^4.18.1",
    "typescript": "^6.0.3",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cli-progress": "^3.11.6",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.27",
    "@types/node": "^20.19.43",
    "@types/yargs": "^17.0.35",
    "@yao-pkg/pkg": "^6.25.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest-extended": "^3.0.1",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-extended": "^7.0.0",
    "jest-mock-extended": "^4.0.2",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.73.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
